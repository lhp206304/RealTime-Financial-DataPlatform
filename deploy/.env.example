# 部署环境变量模板。
# 用法：cp .env.example .env，按需改值。docker compose 启动时自动读取同目录 .env 插值。
# .env 含真实密码，已被 .gitignore 忽略，不会提交；本模板 .env.example 可提交。
#
# 所有变量都有默认值（见 docker-compose.yml 的 ${VAR:-默认}），本地开发不建 .env 也能跑。
# 只有「换环境 / 改密码」时才需要在 .env 里覆盖。

# ---- MinIO（对象存储）----
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin          # 生产改成强密码
MINIO_BUCKET_DIM=dim
MINIO_BUCKET_FACT=fact

# ---- ClickHouse（离线 OLAP，HTTP 8123）----
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=finance

# ---- StarRocks（实时 OLAP，MySQL 9030）----
STARROCKS_HOST=starrocks
STARROCKS_MYSQL_PORT=9030
STARROCKS_USER=root
STARROCKS_PASSWORD=
STARROCKS_DATABASE=finance

# ---- Redis（维表缓存）----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---- Spark standalone ----
SPARK_MASTER=spark://spark-master:7077
